---
import { SocialsBar } from "@/features/socials/socials-bar";
import { SocialsSheet } from "@/features/socials/socials-sheet";
import { Separator } from "@/atoms/separator";
import pfp from "@/assets/pfp.webp";
import { posts, slugs } from "@/blog/posts";
import ScrollWrapper from "@/components/ScrollWrapper.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <ScrollWrapper>
    <div class="mx-auto my-16 flex max-w-xl flex-col gap-4 px-4">
      <div class="flex items-center gap-4">
        <img
          src="https://bsx-main.b-cdn.net/pfp.webp"
          alt="Profile Picture"
          width={80}
          height={80}
          class="rounded-full"
        />
        <div class="flex flex-col justify-center">
          <span class="font-semibold">shawn</span>
          <span class="text-muted-foreground text-sm">@bentsignal</span>
        </div>
        <SocialsBar className="ml-auto hidden sm:flex" />
        <SocialsSheet className="ml-auto sm:hidden" client:load />
      </div>
      <span>
        This is a space for me to discuss software, photography, videography,
        music, math, and anything else I find interesting.
      </span>
      <Separator className="my-1" client:load />
      <div class="flex flex-col gap-3">
        {
          slugs.map((slug) => {
            const post = posts[slug];
            return (
              <a href={`/${slug}`}>
                <div class="text-muted-foreground hover:text-primary flex flex-col items-start justify-between gap-1 rounded-md transition-colors duration-100 lg:flex-row lg:items-center">
                  <h2 class="font-semibold">{post.title}</h2>
                  <p class="hidden text-sm sm:block">
                    {post.datePosted.toLocaleDateString(undefined, {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </p>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </ScrollWrapper>
</BaseLayout>
