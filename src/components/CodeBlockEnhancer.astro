const ICON_WRAP = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="6" y2="6"/><path d="M3 12h15a3 3 0 1 1 0 6h-4"/><polyline points="16 16 14 18 16 20"/><line x1="3" x2="10" y1="18" y2="18"/></svg>`;

const ICON_NOWRAP = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10H7"/><path d="M21 6H3"/><path d="M21 14H3"/><path d="M21 18H7"/></svg>`;

const ICON_LINED = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>`;

const ICON_NUMBERED = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="21" y1="6" y2="6"/><line x1="10" x2="21" y1="12" y2="12"/><line x1="10" x2="21" y1="18" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>`;

const ICON_COPY = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;

const ICON_CHECK = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;

interface LangInfo {
  label: string;
  icon: string;
}

const LANGUAGES: Record<string, LangInfo> = {
  tsx: { label: "React", icon: REACT_ICON },
  jsx: { label: "React", icon: REACT_ICON },
  typescript: { label: "TypeScript", icon: TS_ICON },
  ts: { label: "TypeScript", icon: TS_ICON },
};

function createButton(icon: string, title: string): HTMLButtonElement {
  const btn = document.createElement("button");
  btn.innerHTML = icon;
  btn.title = title;
  btn.className = "code-frame-btn";
  return btn;
}

function enhanceCodeBlocks() {
  const codeBlocks = document.querySelectorAll(
    "pre.astro-code:not([data-enhanced])"
  );

  codeBlocks.forEach((pre) => {
    pre.setAttribute("data-enhanced", "true");

    const lang = pre.getAttribute("data-language") || "";
    const codeEl = pre.querySelector("code");
    if (!codeEl) return;

    const langInfo = LANGUAGES[lang] || { label: lang, icon: "" };

    // Create wrapper
    const wrapper = document.createElement("div");
    wrapper.className = "code-frame";

    // Header
    const header = document.createElement("div");
    header.className = "code-frame-header";

    // Language label
    const langDiv = document.createElement("div");
    langDiv.className = "code-frame-lang";
    langDiv.innerHTML = `${langInfo.icon}<span>${langInfo.label}</span>`;

    // Controls
    const controls = document.createElement("div");
    controls.className = "code-frame-controls";

    // State
    let wrapLines = true;
    let showLineNumbers = false;

    // Apply default wrap state
    codeEl.style.whiteSpace = "pre-wrap";
    codeEl.style.wordBreak = "break-word";

    // Wrap toggle
    const wrapBtn = createButton(ICON_NOWRAP, "Toggle line wrapping");
    wrapBtn.addEventListener("click", () => {
      wrapLines = !wrapLines;
      if (wrapLines) {
        codeEl.style.whiteSpace = "pre-wrap";
        codeEl.style.wordBreak = "break-word";
        wrapBtn.innerHTML = ICON_NOWRAP;
      } else {
        codeEl.style.whiteSpace = "pre";
        codeEl.style.wordBreak = "normal";
        wrapBtn.innerHTML = ICON_WRAP;
      }
    });

    // Line numbers toggle
    const lineNumBtn = createButton(ICON_NUMBERED, "Toggle line numbers");
    lineNumBtn.addEventListener("click", () => {
      showLineNumbers = !showLineNumbers;
      pre.classList.toggle("show-line-numbers", showLineNumbers);
      lineNumBtn.innerHTML = showLineNumbers ? ICON_LINED : ICON_NUMBERED;
    });

    // Copy button
    const copyBtn = createButton(ICON_COPY, "Copy");
    copyBtn.addEventListener("click", async () => {
      try {
        const text = codeEl.textContent?.trim() || "";
        await navigator.clipboard.writeText(text);
        copyBtn.innerHTML = ICON_CHECK;
        setTimeout(() => {
          copyBtn.innerHTML = ICON_COPY;
        }, 1000);
      } catch {
        console.error("Failed to copy");
      }
    });

    controls.append(wrapBtn, lineNumBtn, copyBtn);
    header.append(langDiv, controls);

    // Assemble
    pre.parentNode!.insertBefore(wrapper, pre);
    wrapper.append(header, pre);
  });
}

document.addEventListener("astro:page-load", enhanceCodeBlocks);
</script>
